	)
	(text "D40 deve ficar junto ao RJ11; R41, D41 e C40 junto ao U40. Manter plano GND continuo e retorno curto para D40.\nD40 e a protecao primaria do cabo; D41 apenas limita o residuo no buffer. Sem isolamento ou qualificacao contra raios: validar transitorios em bancada."
		(exclude_from_sim no)
		(at 19.558 133.858 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f03ca06b-0727-55b1-a6e3-7afb189913ff")
	)
