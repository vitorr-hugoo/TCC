	)
	(text "MISOL WH-SP-WD: rede resistiva passiva; 8 chaves / ate 16 codigos; cabo ~2 m.\nJ32: p2=GND; p3=+3V3; p4=direcao do vento; p1/p5/p6=NC."
		(exclude_from_sim no)
		(at 21.082 34.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3a664b29-c6cd-5df5-a3d7-06d1115da2f5")
	)
	(text "1  CONECTOR / DIVISOR"
		(exclude_from_sim no)
		(at 20.828 42.672 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7143d130-b54d-531b-b487-b31ff9e1854b")
	)
	(text "R50=10k 1%; ADC ideal=4095*R_sensor/(10000+R_sensor).\nR51/R52 estao APOS o divisor: nao entram na relacao DC ideal.\nRfonte maxima ~20,23k; C50=100n: tau maxima ~2,02 ms; validar tempo ADC (144 ciclos)."
		(exclude_from_sim no)
		(at 23.114 118.872 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a539af0e-e569-53f6-a019-eaeb2d66f387")
	)
	(text "2  LIMITACAO / CLAMP"
		(exclude_from_sim no)
		(at 112.268 42.672 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aa2e37d0-5fa5-54bb-bd51-4259a2c19ef9")
	)
	(text "AVREF_SENSOR deve vir de VDDA/AVDD do STM32, apos o filtro analogico; nao unir ao 3V3 digital por etiqueta.\nC50 junto ao PA0; retorno GND curto. Medir offsets por fuga e temperatura.\nA LUT ativa do firmware tem 16 entradas; 8 e o numero de amostras por leitura."
		(exclude_from_sim no)
		(at 22.86 132.588 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f06a2197-8154-5d0d-b182-d7abc08f2175")
	)
